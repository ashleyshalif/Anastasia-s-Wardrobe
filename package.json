{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "setup": "python setup.py",
    "setup:ps": "powershell -ExecutionPolicy Bypass -File .\\SETUP_PROJECT.ps1",
    "dev": "python start.py",
    "start": "python start.py",
    "build": "pnpm -r --filter \"./artifacts/**\" --if-present run build",
    "typecheck": "pnpm -r --filter \"./artifacts/**\" --if-present run typecheck"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}