# ==============================================================================
# Ryna's Wardrobe — Root Environment Blueprint (.env.example)
# This file provides an architectural summary of all project environment configs.
# Copy to backend/.env and artifacts/rynas-wardrobe/.env.local respectively.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE LOCAL DEFAULTS
# ------------------------------------------------------------------------------
PORT_FRONTEND=3000
PORT_BACKEND=8000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 2. LOCAL SECRETS (Generate with python -c "import secrets; print(secrets.token_urlsafe(50))")
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=django-insecure-rynas-wardrobe-local-dev-key-change-in-prod-2026

# ------------------------------------------------------------------------------
# 3. PLUG-AND-PLAY INTEGRATIONS (Optional for local testing — Safe fallbacks enabled)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/account

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Ryna's Wardrobe
SMTP_FROM_EMAIL=care@rynaswardrobe.com
