# ==============================================================================
# Anastasia's Wardrobe — Environment Configuration (.env.example)
# Duplicate this file as .env.local for local Next.js development.
# ==============================================================================

# --- Frontend Application & Canonical URLs ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Backend API Service (Django REST Framework / Node.js) ---
# Set to your Django backend URL (e.g. http://localhost:8000/api or https://api.anastasiaswardrobe.com)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# --- Development / Prototyping Mode ---
# When set to "true", the frontend gracefully falls back to mock catalog & order data
# if the backend API is unreachable or still in development.
NEXT_PUBLIC_USE_MOCK_DATA=true

# --- Payment Gateway: Razorpay (India & UPI) ---
# Obtain from Razorpay Dashboard > Settings > API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpayKeySecretHere

# --- Payment Gateway: Stripe (International Cards & Apple Pay) ---
# Obtain from Stripe Dashboard > Developers > API Keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YourStripePublishableKeyHere
STRIPE_SECRET_KEY=sk_test_YourStripeSecretKeyHere

# --- Logistics & Courier Tracking: Blue Dart Express ---
# Credentials for Blue Dart reverse & forward courier AWB integration
NEXT_PUBLIC_BLUE_DART_API_KEY=your_bluedart_api_key_here
NEXT_PUBLIC_BLUE_DART_CLIENT_ID=your_bluedart_client_id_here
BLUE_DART_API_SECRET=your_bluedart_secret_here

# --- Authentication & Session Security ---
# Secret used by backend for signing JWT session tokens
JWT_SECRET=super_secret_jwt_encryption_key_change_in_production
JWT_EXPIRATION_HOURS=72

# --- Concierge Helpline & Contact Defaults ---
NEXT_PUBLIC_CONCIERGE_PHONE=+919820012345
NEXT_PUBLIC_CONCIERGE_EMAIL=hello@anastasiaswardrobe.com
