# ==============================================================================
# Ryna's Wardrobe — Frontend Environment Configuration (.env.example)
# Duplicate this file as 'artifacts/rynas-wardrobe/.env.local' for Next.js.
# ==============================================================================

# ==============================================================================
# 1. CORE LOCAL SETUP (Pre-filled with safe local defaults)
# ==============================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
NEXT_PUBLIC_USE_MOCK_DATA=false

# Support & Concierge Brand Info
NEXT_PUBLIC_CONCIERGE_PHONE=+919820012345
NEXT_PUBLIC_CONCIERGE_EMAIL=care@rynaswardrobe.com

# ==============================================================================
# 2. SECRETS TO GENERATE LOCALLY
# ==============================================================================
# Client application runs on public browser keys; no server-side secrets required here.

# ==============================================================================
# 3. PLUG-AND-PLAY EXTERNAL APIS (Optional for local boot — safe fallbacks active)
# ==============================================================================

# ─── Razorpay Public Key ID ───────────────────────────────────────────────────
# Client Key ID (begins with rzp_test_ or rzp_live_)
# Pre-filled with an evaluation test key for instant out-of-the-box checkout demo.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_519RynaAtelier

# ─── Google OAuth 2.0 Web Client ID ───────────────────────────────────────────
# Client ID from Google Cloud Console > APIs & Services > Credentials
# Leave blank to run with instant one-click Patron evaluation sign-in.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
