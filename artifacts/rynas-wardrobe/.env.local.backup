# ─── Django Backend URL ───────────────────────────────────────────────────────
# This tells the Next.js frontend where to find the Django API.
# Change this if Django runs on a different port.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# ─── Feature Flags ────────────────────────────────────────────────────────────
# Set to "true" to force mock data (bypass the Django API).
# Leave as "false" or remove to use the real Django backend.
NEXT_PUBLIC_USE_MOCK_DATA=false

# ─── Razorpay Public Key (Sandbox) ───────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_519RynaAtelier

