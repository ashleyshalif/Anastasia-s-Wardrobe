# ==============================================================================
# Ryna's Wardrobe — Backend Environment Configuration (.env.example)
# Duplicate this file as 'backend/.env' for local Django REST development.
# ==============================================================================

# ==============================================================================
# 1. CORE LOCAL SETUP (Pre-filled with safe local defaults)
# ==============================================================================
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
FRONTEND_URL=http://localhost:3000
CONN_MAX_AGE=600

# Superuser Initial Credentials (used by automated seeder/createsuperuser)
DJANGO_SUPERUSER_USERNAME=USER
DJANGO_SUPERUSER_EMAIL=staff@rynaswardrobe.com
DJANGO_SUPERUSER_PASSWORD=Maya@123

# ==============================================================================
# 2. SECRETS TO GENERATE LOCALLY
# ==============================================================================
# Generate a new unique secret key using this 1-line command:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=django-insecure-rynas-wardrobe-atelier-local-development-key-change-in-prod-2026

# ==============================================================================
# 3. PLUG-AND-PLAY EXTERNAL APIS (Optional for local boot — safe fallbacks active)
# ==============================================================================

# ─── Razorpay Payment Gateway ─────────────────────────────────────────────────
# Obtain from: https://dashboard.razorpay.com/app/keys
# Leave blank to run in simulated evaluation mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Google OAuth 2.0 (Social Sign-In) ─────────────────────────────────────────
# Obtain from: Google Cloud Console > APIs & Services > Credentials
# Web Client Redirect URI: http://localhost:3000/account
# Leave blank to run in graceful evaluation mode.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/account

# ─── Transactional SMTP Email ─────────────────────────────────────────────────
# Works with Gmail (App Password), Outlook, Amazon SES, Brevo, SendGrid
# Leave blank to output dispatched emails to the terminal console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Ryna's Wardrobe
SMTP_FROM_EMAIL=care@rynaswardrobe.com
